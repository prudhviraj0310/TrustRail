# TrustRail configuration. Copy to `.env` and adjust.
# Every value has a safe zero-setup default; you can run with no .env at all.

# App
APP_NAME=TrustRail
ENVIRONMENT=local

# Database — SQLite by default (zero setup). For PostgreSQL (the intended
# production source of truth) use the psycopg driver, e.g.:
#   DATABASE_URL=postgresql+psycopg://trustrail:trustrail@localhost:5432/trustrail
DATABASE_URL=sqlite:///./trustrail.db

# Create tables on startup. Fine for dev/SQLite. In production prefer Alembic
# migrations (see migrations/) and set this to false.
AUTO_CREATE_TABLES=true

# Seed the synthetic merchant catalogue on startup.
SEED_MERCHANT=true

# ---------------------------------------------------------------------------
# PHASE 2 — Payment gateway selection.
#   mock     -> deterministic in-process gateway (default; offline; no creds).
#   razorpay -> Razorpay Test Mode (requires the three secrets below).
# The default MUST remain `mock` so `make test` stays offline.
PAYMENT_GATEWAY=mock

# ---------------------------------------------------------------------------
# PHASE 2 — Razorpay Test Mode credentials.
# Server-side ONLY. Never expose these to the AI agent; never commit real
# values. Get Test Mode keys at https://dashboard.razorpay.com (Test Mode) and
# the webhook secret when you create the webhook. Placeholders shown below.
# RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
# RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
# RAZORPAY_WEBHOOK_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
